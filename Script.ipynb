# 3. THIẾT LẬP LIÊN KẾT ĐỒNG BỘ GOOGLE DRIVE (SYMLINKS)
# ==============================================================================
def create_link(source, target):
    """Xóa mục cũ nếu có và tạo symbolic link"""
    if os.path.islink(target) or os.path.isfile(target):
        os.remove(target)
    elif os.path.isdir(target) and not os.path.islink(target):
        import shutil
        shutil.rmtree(target)
    os.system(f"ln -s '{source}' '{target}'")

# Lưu trữ ảnh render theo từng ngày vào Drive để tránh mất mát
