# ==============================================================================
# 4. QUẢN LÝ TUNNELING (CLOUDFLARE & PINGGY)
# ==============================================================================
def wait_for_port(p):
    """Đợi đến khi ComfyUI thực sự mở cổng mạng"""
    while True:
        time.sleep(0.5)
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        res = sock.connect_ex(('127.0.0.1', p))
        sock.close()
        if res == 0:
            break

def cloudflare_thread(p):
    wait_for_port(p)
    # Tải cloudflared nếu chưa có
    if not os.path.exists('/usr/local/bin/cloudflared'):
        !wget -q -nc https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb
        !dpkg -i cloudflared-linux-amd64.deb > /dev/null 2>&1
        !rm cloudflared-linux-amd64.deb

    proc = subprocess.Popen(
        ["cloudflared", "tunnel", "--url", f"http://127.0.0.1:{p}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE
    )
    for line in proc.stderr:
        decoded = line.decode()
        if "trycloudflare.com" in decoded:
            url_match = re.search(r'https://[a-zA-Z0-9-]+\.trycloudflare\.com', decoded)
            if url_match:
                print(f"\n\033[92m🔗 Cloudflare Tunnel URL:\033[0m {url_match.group(0)}\n")
            break

def pinggy_thread(p):
    wait_for_port(p)
    proc = subprocess.Popen(
        ["ssh", "-p", "443", "-o", "StrictHostKeyChecking=no", "-o", "ServerAliveInterval=30", f"-R0:localhost:{p}", "free.pinggy.io"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )
    for line in iter(proc.stdout.readline, ''):
        match = re.search(r'(https?://[^\s]+)', line)
        if match and "dashboard.pinggy.io" not in match.group(1):
            print(f"\033[94m🔗 Pinggy Backup URL:\033[0m {match.group(1)}")
            break

# Kích hoạt đa luồng lắng nghe tunnel
threading.Thread(target=cloudflare_thread, args=(port,), daemon=True).start()
threading.Thread(target=pinggy_thread, args=(port,), daemon=True).start()

