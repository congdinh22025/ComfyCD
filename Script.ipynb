    f'{user_drive_folder}/Model/checkpoints': f'{comfy_dir}/models/checkpoints',
    f'{user_drive_folder}/Model/loras': f'{comfy_dir}/models/loras',
    f'{user_drive_folder}/Model/vae': f'{comfy_dir}/models/vae',
    f'{user_drive_folder}/Model/controlnet': f'{comfy_dir}/models/controlnet',
    f'{user_drive_folder}/Model/upscale_models': f'{comfy_dir}/models/upscale_models',
    today_export: f'{comfy_dir}/output'
}

for src, dst in symlink_map.items():
    create_link(src, dst)

